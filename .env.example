# AfriVoice Environment Variables
# Copy this file to .env.local and fill in your actual values

# ============================================
# CLERK AUTHENTICATION
# ============================================
# Get these from: https://dashboard.clerk.com
# Go to: API Keys section

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk redirect URLs (customize if needed)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ============================================
# SUPABASE DATABASE
# ============================================
# Get these from: https://app.supabase.com
# Go to: Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# VAPI VOICE AI
# ============================================
# Get these from: https://dashboard.vapi.ai
# Go to: API Keys

NEXT_PUBLIC_VAPI_PUBLIC_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VAPI_PRIVATE_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ============================================
# SENTRY ERROR TRACKING (Optional)
# ============================================
# Get this from: https://sentry.io
# Go to: Settings > Projects > Client Keys (DSN)

NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxxxx
SENTRY_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# DEPLOYMENT (Vercel)
# ============================================
# These are automatically set by Vercel
# You don't need to add these manually

# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=afrivoice.vercel.app

# ============================================
# NOTES
# ============================================
# - Never commit .env.local to git
# - Add .env.local to .gitignore
# - Store production secrets in Vercel dashboard
# - Use different keys for development and production
# - Rotate keys regularly for security
